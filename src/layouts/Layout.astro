<script>
	// 产品搜索数据
	const searchProducts = [
		{ id: 1, series: '300', name: 'Front Bumper', category: 'Bumpers', price: 649 },
		{ id: 2, series: '400', name: 'Side Skirt Set', category: 'Side Skirts', price: 499 },
		{ id: 3, series: '500', name: 'Rear Bumper', category: 'Bumpers', price: 729 },
		{ id: 4, series: '300', name: 'Rear Spoiler', category: 'Spoilers', price: 399 },
		{ id: 5, series: '400', name: 'Wide Body Kit', category: 'Body Kits', price: 2499 },
		{ id: 6, series: '500', name: 'Carbon Hood', category: 'Hoods', price: 1199 },
	];

	// 搜索弹窗
	document.getElementById('searchBtn')?.addEventListener('click', () => {
		document.getElementById('searchOverlay')?.classList.add('open');
		document.getElementById('searchInput')?.focus();
	});
	document.getElementById('searchClose')?.addEventListener('click', () => {
		document.getElementById('searchOverlay')?.classList.remove('open');
	});
	document.getElementById('searchOverlay')?.addEventListener('click', (e) => {
		if (e.target === e.currentTarget) {
			e.currentTarget.classList.remove('open');
		}
	});

	// 搜索逻辑
	const searchInput = document.getElementById('searchInput');
	const searchResults = document.getElementById('searchResults');

	function doSearch(query) {
		if (!searchResults) return;
		if (!query.trim()) {
			searchResults.innerHTML = '';
			return;
		}
		const q = query.toLowerCase();
		const matches = searchProducts.filter(p =>
			p.name.toLowerCase().includes(q) ||
			p.category.toLowerCase().includes(q) ||
			p.series.includes(q)
		);
		if (matches.length === 0) {
			searchResults.innerHTML = '<div class="search-result-item empty">No products found for "' + query + '"</div>';
			return;
		}
		searchResults.innerHTML = matches.map(p => `
			<a href="/product/${p.id}" class="search-result-item">
				<div class="search-result-img">Image</div>
				<div class="search-result-info">
					<span class="search-result-series">Tank ${p.series} · ${p.category}</span>
					<h4>${p.name}</h4>
				</div>
				<span class="search-result-price">$${p.price.toLocaleString()}</span>
			</a>
		`).join('');
	}

	let searchTimeout;
	searchInput?.addEventListener('input', (e) => {
		clearTimeout(searchTimeout);
		searchTimeout = setTimeout(() => doSearch(e.target.value), 200);
	});

	// ESC 关闭
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			document.getElementById('searchOverlay')?.classList.remove('open');
		}
	});

	// 购物车徽章
	function updateCartBadge(count) {
		const badge = document.getElementById('cartBadge');
		if (!badge) return;
		if (count > 0) {
			badge.textContent = count > 99 ? '99+' : count;
			badge.style.display = 'flex';
		} else {
			badge.style.display = 'none';
		}
	}

	function getCartCount() {
		try {
			const cart = JSON.parse(localStorage.getItem('tankgarage_cart') || '[]');
			return cart.reduce((sum, item) => sum + item.quantity, 0);
		} catch { return 0; }
	}

	updateCartBadge(getCartCount());
	window.addEventListener('cart-updated', (e) => updateCartBadge(e.detail.count));
</script>

