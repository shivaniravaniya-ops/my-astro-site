---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<section class="page-header">
		<div class="container">
			<h1>My Account</h1>
			<p id="accountSubtitle">Sign in to manage your orders and saved parts</p>
		</div>
	</section>

	<section class="account-section">
		<div class="container">
			<!-- Logged In View -->
			<div class="account-panel" id="panelLoggedIn" style="display:none;">
				<div class="form-card">
					<div class="user-info">
						<div class="user-avatar" id="userAvatar">👤</div>
						<div>
							<h2 id="userName">Welcome!</h2>
							<p id="userEmail" class="user-email"></p>
						</div>
					</div>
					<div class="logged-in-actions">
						<a href="/orders" class="btn-secondary">📦 My Orders</a>
						<button class="btn-outline" id="logoutBtn">Sign Out</button>
					</div>
				</div>
			</div>

			<!-- Guest View -->
			<div class="account-tabs" id="accountTabs">
				<button class="tab-btn active" id="tabSignIn">Sign In</button>
				<button class="tab-btn" id="tabRegister">Create Account</button>
			</div>

			<!-- Sign In Panel -->
			<div class="account-panel" id="panelSignIn">
				<div class="form-card">
					<h2>Welcome Back</h2>
					<p class="form-subtitle">Sign in to your TankGarage account</p>
					<form class="auth-form" id="signInForm">
						<div class="form-group">
							<label for="signin-email">Email Address</label>
							<input type="email" id="signin-email" placeholder="your@email.com" required />
						</div>
						<div class="form-group">
							<label for="signin-password">Password</label>
							<input type="password" id="signin-password" placeholder="Your password" required />
						</div>
						<div class="form-row-link">
							<a href="#" class="forgot-link">Forgot password?</a>
						</div>
						<button type="submit" class="btn-auth" id="signinBtn">Sign In</button>
						<p class="error-msg" id="signinError" style="display:none;"></p>
					</form>
				</div>
			</div>

			<!-- Register Panel -->
			<div class="account-panel hidden" id="panelRegister">
				<div class="form-card">
					<h2>Create Account</h2>
					<p class="form-subtitle">Join TankGarage for exclusive deals and order tracking</p>
					<form class="auth-form" id="registerForm">
						<div class="form-row">
							<div class="form-group">
								<label for="reg-firstname">First Name</label>
								<input type="text" id="reg-firstname" placeholder="First name" required />
							</div>
							<div class="form-group">
								<label for="reg-lastname">Last Name</label>
								<input type="text" id="reg-lastname" placeholder="Last name" required />
							</div>
						</div>
						<div class="form-group">
							<label for="reg-email">Email Address</label>
							<input type="email" id="reg-email" placeholder="your@email.com" required />
						</div>
						<div class="form-group">
							<label for="reg-password">Password</label>
							<input type="password" id="reg-password" placeholder="Min. 8 characters" minlength="8" required />
						</div>
						<div class="form-group">
							<label for="reg-confirm">Confirm Password</label>
							<input type="password" id="reg-confirm" placeholder="Repeat password" minlength="8" required />
						</div>
						<div class="form-check">
							<input type="checkbox" id="reg-newsletter" />
							<label for="reg-newsletter">Subscribe to our newsletter for deals and Tank build inspiration</label>
						</div>
						<div class="form-check">
							<input type="checkbox" id="reg-terms" required />
							<label for="reg-terms">I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a></label>
						</div>
						<button type="submit" class="btn-auth" id="registerBtn">Create Account</button>
						<p class="error-msg" id="registerError" style="display:none;"></p>
					</form>
				</div>
			</div>
		</div>
	</section>

	<!-- Success Modal -->
	<div class="success-modal" id="successModal" style="display:none;">
		<div class="success-content">
			<div class="success-icon">✅</div>
			<h2 id="modalTitle">Success!</h2>
			<p id="modalMessage">Your action was successful.</p>
			<button class="btn-ok" id="modalOkBtn">OK</button>
		</div>
	</div>
</Layout>

<script>
	// Auth state
	const AUTH_KEY = 'tankgarage_auth';

	function getAuth() {
		try {
			return JSON.parse(localStorage.getItem(AUTH_KEY) || null);
		} catch { return null; }
	}

	function saveAuth(auth: any) {
		localStorage.setItem(AUTH_KEY, JSON.stringify(auth));
		updateUI(auth);
	}

	function clearAuth() {
		localStorage.removeItem(AUTH_KEY);
		updateUI(null);
	}

	function updateUI(auth: any) {
		const loggedInPanel = document.getElementById('panelLoggedIn');
		const guestView = document.getElementById('accountTabs');
		const signInPanel = document.getElementById('panelSignIn');
		const regPanel = document.getElementById('panelRegister');
		const subtitle = document.getElementById('accountSubtitle');
		const userName = document.getElementById('userName');
		const userEmail = document.getElementById('userEmail');

		if (auth) {
			loggedInPanel.style.display = 'block';
			guestView.style.display = 'none';
			signInPanel.classList.add('hidden');
			regPanel.classList.add('hidden');
			subtitle.textContent = 'Manage your account and orders';
			userName.textContent = `Welcome, ${auth.firstName}!`;
			userEmail.textContent = auth.email;
		} else {
			loggedInPanel.style.display = 'none';
			guestView.style.display = 'flex';
			signInPanel.classList.remove('hidden');
			regPanel.classList.add('hidden');
			subtitle.textContent = 'Sign in to manage your orders and saved parts';
		}
	}

	function showModal(title: string, message: string) {
		(document.getElementById('modalTitle') as HTMLElement).textContent = title;
		(document.getElementById('modalMessage') as HTMLElement).textContent = message;
		(document.getElementById('successModal') as HTMLElement).style.display = 'flex';
	}

	function hideModal() {
		(document.getElementById('successModal') as HTMLElement).style.display = 'none';
	}

	function showError(elId: string, msg: string) {
		const el = document.getElementById(elId) as HTMLElement;
		el.textContent = msg;
		el.style.display = 'block';
	}

	function clearErrors() {
		showError('signinError', '');
		showError('registerError', '');
	}

	// Tab switching
	document.getElementById('tabSignIn')?.addEventListener('click', () => {
		clearErrors();
		document.getElementById('tabSignIn')?.classList.add('active');
		document.getElementById('tabRegister')?.classList.remove('active');
		document.getElementById('panelSignIn')?.classList.remove('hidden');
		document.getElementById('panelRegister')?.classList.add('hidden');
	});

	document.getElementById('tabRegister')?.addEventListener('click', () => {
		clearErrors();
		document.getElementById('tabRegister')?.classList.add('active');
		document.getElementById('tabSignIn')?.classList.remove('active');
		document.getElementById('panelRegister')?.classList.remove('hidden');
		document.getElementById('panelSignIn')?.classList.add('hidden');
	});

	// Login
	document.getElementById('signInForm')?.addEventListener('submit', async (e) => {
		e.preventDefault();
		clearErrors();
		const btn = document.getElementById('signinBtn') as HTMLButtonElement;
		btn.disabled = true;
		btn.textContent = 'Signing in...';

		const email = (document.getElementById('signin-email') as HTMLInputElement).value.trim();
		const password = (document.getElementById('signin-password') as HTMLInputElement).value;

		try {
			const res = await fetch('/api/auth/login', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email, password })
			});

			const data = await res.json();

			if (res.ok && data.success) {
				saveAuth(data.user);
				showModal('Welcome Back!', `Signed in as ${data.user.firstName}`);
			} else {
				showError('signinError', data.error || 'Login failed. Please try again.');
			}
		} catch (err) {
			showError('signinError', 'Unable to connect. Please try again.');
		} finally {
			btn.disabled = false;
			btn.textContent = 'Sign In';
		}
	});

	// Register
	document.getElementById('registerForm')?.addEventListener('submit', async (e) => {
		e.preventDefault();
		clearErrors();
		const btn = document.getElementById('registerBtn') as HTMLButtonElement;
		btn.disabled = true;
		btn.textContent = 'Creating account...';

		const firstName = (document.getElementById('reg-firstname') as HTMLInputElement).value.trim();
		const lastName = (document.getElementById('reg-lastname') as HTMLInputElement).value.trim();
		const email = (document.getElementById('reg-email') as HTMLInputElement).value.trim();
		const password = (document.getElementById('reg-password') as HTMLInputElement).value;
		const confirm = (document.getElementById('reg-confirm') as HTMLInputElement).value;
		const terms = (document.getElementById('reg-terms') as HTMLInputElement).checked;

		if (password !== confirm) {
			showError('registerError', 'Passwords do not match.');
			btn.disabled = false;
			btn.textContent = 'Create Account';
			return;
		}

		if (password.length < 8) {
			showError('registerError', 'Password must be at least 8 characters.');
			btn.disabled = false;
			btn.textContent = 'Create Account';
			return;
		}

		if (!terms) {
			showError('registerError', 'Please agree to the Terms of Service.');
			btn.disabled = false;
			btn.textContent = 'Create Account';
			return;
		}

		try {
			const res = await fetch('/api/auth/register', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email, password, firstName, lastName })
			});

			const data = await res.json();

			if (res.ok && data.success) {
				saveAuth(data.user);
				showModal('Account Created!', `Welcome to TankGarage, ${firstName}!`);
			} else {
				showError('registerError', data.error || 'Registration failed. Please try again.');
			}
		} catch (err) {
			showError('registerError', 'Unable to connect. Please try again.');
		} finally {
			btn.disabled = false;
			btn.textContent = 'Create Account';
		}
	});

	// Logout
	document.getElementById('logoutBtn')?.addEventListener('click', async () => {
		await fetch('/api/auth/logout', { method: 'POST' });
		clearAuth();
		showModal('Signed Out', 'You have been signed out successfully.');
	});

	// Modal OK button
	document.getElementById('modalOkBtn')?.addEventListener('click', hideModal);

	// Init
	updateUI(getAuth());
</script>

<style>
	.page-header { padding: 60px 0 40px; text-align: center; }
	.page-header h1 { font-family: 'Space Grotesk', sans-serif; font-size: 42px; font-weight: 800; margin-bottom: 12px; }
	.page-header p { font-size: 16px; color: var(--color-text-muted); }

	.account-section { padding: 40px 0 80px; }

	/* Tabs */
	.account-tabs { display: flex; border-bottom: 2px solid var(--color-border); margin-bottom: 40px; max-width: 500px; margin-left: auto; margin-right: auto; }
	.tab-btn { flex: 1; padding: 14px; background: none; border: none; font-size: 15px; font-weight: 600; color: var(--color-text-muted); cursor: pointer; font-family: inherit; border-bottom: 3px solid transparent; margin-bottom: -2px; transition: all 0.2s; }
	.tab-btn:hover { color: var(--color-primary); }
	.tab-btn.active { color: var(--color-primary); border-bottom-color: var(--color-primary); }

	.account-panel { max-width: 500px; margin: 0 auto; }
	.account-panel.hidden { display: none; }

	.form-card { background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius); padding: 40px; }
	.form-card h2 { font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 700; margin-bottom: 6px; }
	.form-subtitle { font-size: 14px; color: var(--color-text-muted); margin-bottom: 28px; }

	.auth-form { display: flex; flex-direction: column; gap: 16px; }
	.form-group { display: flex; flex-direction: column; gap: 7px; }
	.form-group label { font-size: 13px; font-weight: 600; color: var(--color-text); }
	.form-group input { padding: 13px 16px; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 14px; color: var(--color-text); font-family: inherit; outline: none; transition: border-color 0.2s; }
	.form-group input:focus { border-color: var(--color-primary); }
	.form-group input::placeholder { color: var(--color-text-muted); }

	.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
	.form-row-link { text-align: right; }
	.forgot-link { font-size: 13px; color: var(--color-primary); }
	.forgot-link:hover { text-decoration: underline; }

	.error-msg { font-size: 13px; color: #ef4444; padding: 10px; background: #fef2f2; border-radius: 6px; text-align: center; }

	.btn-auth { padding: 14px; background: var(--color-primary); color: #fff; border: none; border-radius: var(--radius-sm); font-size: 15px; font-weight: 700; cursor: pointer; font-family: inherit; transition: all 0.2s; margin-top: 8px; }
	.btn-auth:hover:not(:disabled) { background: var(--color-primary-dark); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(255,69,0,0.3); }
	.btn-auth:disabled { opacity: 0.6; cursor: not-allowed; }

	/* Logged in user card */
	.user-info { display: flex; align-items: center; gap: 20px; margin-bottom: 28px; }
	.user-avatar { font-size: 48px; }
	.user-info h2 { font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 700; margin-bottom: 4px; }
	.user-email { font-size: 14px; color: var(--color-text-muted); }
	.logged-in-actions { display: flex; gap: 12px; }
	.btn-secondary { padding: 12px 24px; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 14px; font-weight: 600; color: var(--color-text); cursor: pointer; font-family: inherit; transition: all 0.2s; text-decoration: none; display: inline-block; }
	.btn-secondary:hover { border-color: var(--color-primary); color: var(--color-primary); }
	.btn-outline { padding: 12px 24px; background: transparent; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-size: 14px; font-weight: 600; color: var(--color-text); cursor: pointer; font-family: inherit; transition: all 0.2s; }
	.btn-outline:hover { border-color: var(--color-primary); color: var(--color-primary); }

	/* Form checks */
	.form-check { display: flex; align-items: flex-start; gap: 10px; font-size: 13px; color: var(--color-text-muted); line-height: 1.5; }
	.form-check input[type="checkbox"] { margin-top: 3px; accent-color: var(--color-primary); }
	.form-check a { color: var(--color-primary); }
	.form-check a:hover { text-decoration: underline; }

	/* Success Modal */
	.success-modal { position: fixed; inset: 0; background: rgba(26,26,46,0.7); display: flex; align-items: center; justify-content: center; z-index: 300; }
	.success-content { background: #fff; border-radius: var(--radius); padding: 48px; text-align: center; max-width: 420px; width: 90%; }
	.success-icon { font-size: 56px; margin-bottom: 16px; }
	.success-content h2 { font-family: 'Space Grotesk', sans-serif; font-size: 22px; font-weight: 700; margin-bottom: 10px; }
	.success-content p { font-size: 14px; color: var(--color-text-muted); line-height: 1.7; margin-bottom: 24px; }
	.btn-ok { padding: 12px 40px; background: var(--color-primary); color: #fff; border: none; border-radius: var(--radius-sm); font-size: 14px; font-weight: 700; cursor: pointer; font-family: inherit; transition: background 0.2s; }
	.btn-ok:hover { background: var(--color-primary-dark); }

	@media (max-width: 768px) { .form-row { grid-template-columns: 1fr; } .form-card { padding: 28px 20px; } }
</style>
