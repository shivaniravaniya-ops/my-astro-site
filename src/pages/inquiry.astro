---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<!-- ========== 页面标题栏 ========== -->
	<section class="page-header">
		<div class="container">
			<h1>询价采购</h1>
			<p>提交您的采购需求，专业客户经理将在24小时内为您提供报价</p>
		</div>
	</section>

	<!-- ========== 询价表单 ========== -->
	<section class="inquiry-section">
		<div class="container">
			<div class="inquiry-layout">
				<!-- 表单主体 -->
				<div class="inquiry-form-wrapper">
					<h2>填写询价信息</h2>
					<form class="inquiry-form" id="inquiryForm">
						<!-- 基本信息 -->
						<div class="form-section">
							<h3>基本信息 <span class="required">*</span></h3>
							<div class="form-row">
								<div class="form-group">
									<label for="companyName">公司名称 <span class="required">*</span></label>
									<input type="text" id="companyName" name="companyName" placeholder="请输入公司全称" required />
								</div>
								<div class="form-group">
									<label for="contactName">联系人 <span class="required">*</span></label>
									<input type="text" id="contactName" name="contactName" placeholder="请输入联系人姓名" required />
								</div>
							</div>
							<div class="form-row">
								<div class="form-group">
									<label for="email">邮箱地址 <span class="required">*</span></label>
									<input type="email" id="email" name="email" placeholder="用于接收报价单" required />
								</div>
								<div class="form-group">
									<label for="phone">联系电话 <span class="required">*</span></label>
									<input type="tel" id="phone" name="phone" placeholder="+86 地区号-号码" required />
								</div>
							</div>
							<div class="form-row">
								<div class="form-group">
									<label for="country">所在国家/地区</label>
									<select id="country" name="country">
										<option value="">请选择</option>
										<option>中国 China</option>
										<option>美国 United States</option>
										<option>加拿大 Canada</option>
										<option>英国 United Kingdom</option>
										<option>德国 Germany</option>
										<option>法国 France</option>
										<option>澳大利亚 Australia</option>
										<option>日本 Japan</option>
										<option>韩国 South Korea</option>
										<option>其他 Other</option>
									</select>
								</div>
								<div class="form-group">
									<label for="businessType">业务类型</label>
									<select id="businessType" name="businessType">
										<option value="">请选择</option>
										<option>汽配批发商</option>
										<option>维修厂/4S店</option>
										<option>电商卖家</option>
										<option>OEM/ODM定制</option>
										<option>其他</option>
									</select>
								</div>
							</div>
						</div>

						<!-- 采购产品 -->
						<div class="form-section">
							<h3>采购产品明细</h3>
							<div class="product-list" id="productList">
								<div class="product-item">
									<div class="form-row">
										<div class="form-group">
											<label>OE号码 / Part Number</label>
											<input type="text" name="oeNumber[]" placeholder="例如: BP-8850" />
										</div>
										<div class="form-group">
											<label>产品名称</label>
											<input type="text" name="productName[]" placeholder="例如: 前刹车片套装" />
										</div>
									</div>
									<div class="form-row">
										<div class="form-group">
											<label>适用车型</label>
											<input type="text" name="vehicleModel[]" placeholder="例如: 丰田凯美瑞 2018-2024" />
										</div>
										<div class="form-group qty">
											<label>需求量 <span class="required">*</span></label>
											<input type="number" name="quantity[]" placeholder="数量" min="1" />
										</div>
									</div>
									<button type="button" class="btn-remove-product">删除</button>
								</div>
							</div>
							<button type="button" class="btn-add-product" id="addProductBtn">+ 添加更多产品</button>
						</div>

						<!-- 其他需求 -->
						<div class="form-section">
							<h3>其他需求</h3>
							<div class="form-group full">
								<label for="message">留言 / 备注</label>
								<textarea id="message" name="message" rows="4" placeholder="请描述您的其他需求，如：目标价格区间、交货期限、认证要求、特殊包装等..."></textarea>
							</div>
							<div class="form-row">
								<div class="form-group">
									<label for="targetPrice">目标价格</label>
									<input type="text" id="targetPrice" name="targetPrice" placeholder="如: USD 10-12/pcs" />
								</div>
								<div class="form-group">
									<label for="deliveryTime">期望交货期</label>
									<select id="deliveryTime" name="deliveryTime">
										<option value="">请选择</option>
										<option>尽快 / ASAP</option>
										<option>15天内</option>
										<option>30天内</option>
										<option>60天内</option>
										<option>可协商</option>
									</select>
								</div>
							</div>
						</div>

						<!-- 提交按钮 -->
						<div class="form-actions">
							<button type="submit" class="btn-submit">提交询价</button>
							<p class="form-note">提交后，专业客户经理将在24小时内与您联系</p>
						</div>
					</form>
				</div>

				<!-- 侧边栏 -->
				<aside class="inquiry-sidebar">
					<div class="sidebar-card">
						<h3>为什么选择我们？</h3>
						<ul class="benefits-list">
							<li>
								<span class="benefit-icon">✅</span>
								<div>
									<strong>最低起订量支持</strong>
									<p>小批量试单，降低您的风险</p>
								</div>
							</li>
							<li>
								<span class="benefit-icon">📋</span>
								<div>
									<strong>阶梯价格优惠</strong>
									<p>订单量越大，单价越优惠</p>
								</div>
							</li>
							<li>
								<span class="benefit-icon">🚢</span>
								<div>
									<strong>灵活物流方案</strong>
									<p>DDP/DAP/FOB多种发货方式</p>
								</div>
							</li>
							<li>
								<span class="benefit-icon">🔧</span>
								<div>
									<strong>OEM/ODM定制</strong>
									<p>支持品牌定制，LOGO印刷</p>
								</div>
							</li>
						</ul>
					</div>

					<div class="sidebar-card contact-card">
						<h3>联系方式</h3>
						<div class="contact-item">
							<span>📧</span>
							<div>
								<p class="contact-label">邮箱</p>
								<p class="contact-value">info@motorpartspro.com</p>
							</div>
						</div>
						<div class="contact-item">
							<span>📞</span>
							<div>
								<p class="contact-label">电话</p>
								<p class="contact-value">+86 21 8888 9999</p>
							</div>
						</div>
						<div class="contact-item">
							<span>💬</span>
							<div>
								<p class="contact-label">WhatsApp</p>
								<p class="contact-value">+86 138 8888 8888</p>
							</div>
						</div>
						<div class="contact-item">
							<span>📍</span>
							<div>
								<p class="contact-label">地址</p>
								<p class="contact-value">上海市嘉定区工业园区</p>
							</div>
						</div>
					</div>
				</aside>
			</div>
		</div>
	</section>

	<!-- ========== 成功提示（隐藏） ========== -->
	<div class="success-modal" id="successModal" style="display:none;">
		<div class="success-content">
			<div class="success-icon">✅</div>
			<h2>询价提交成功！</h2>
			<p>感谢您的询价，我们的客户经理将在 <strong>24小时</strong> 内与您联系。</p>
			<p>请注意查收邮件，了解报价详情。</p>
			<button type="button" class="btn-close" onclick="closeModal()">关闭</button>
		</div>
	</div>
</Layout>

<script>
	// 添加更多产品
	document.getElementById('addProductBtn').addEventListener('click', function() {
		const productList = document.getElementById('productList');
		const newItem = document.createElement('div');
		newItem.className = 'product-item';
		newItem.innerHTML = `
			<div class="form-row">
				<div class="form-group">
					<label>OE号码 / Part Number</label>
					<input type="text" name="oeNumber[]" placeholder="例如: BP-8850" />
				</div>
				<div class="form-group">
					<label>产品名称</label>
					<input type="text" name="productName[]" placeholder="例如: 前刹车片套装" />
				</div>
			</div>
			<div class="form-row">
				<div class="form-group">
					<label>适用车型</label>
					<input type="text" name="vehicleModel[]" placeholder="例如: 丰田凯美瑞 2018-2024" />
				</div>
				<div class="form-group qty">
					<label>需求量 <span class="required">*</span></label>
					<input type="number" name="quantity[]" placeholder="数量" min="1" />
				</div>
			</div>
			<button type="button" class="btn-remove-product">删除</button>
		`;
		productList.appendChild(newItem);

		// 绑定删除按钮事件
		newItem.querySelector('.btn-remove-product').addEventListener('click', function() {
			productList.removeChild(newItem);
		});
	});

	// 删除产品
	document.querySelectorAll('.btn-remove-product').forEach(function(btn) {
		btn.addEventListener('click', function() {
			const productList = document.getElementById('productList');
			if (productList.children.length > 1) {
				productList.removeChild(btn.parentElement);
			}
		});
	});

	// 表单提交
	document.getElementById('inquiryForm').addEventListener('submit', function(e) {
		e.preventDefault();
		// 显示成功弹窗
		document.getElementById('successModal').style.display = 'flex';
	});

	function closeModal() {
		document.getElementById('successModal').style.display = 'none';
		// 重置表单
		document.getElementById('inquiryForm').reset();
	}
</script>

<style>
	/* ========== 页面标题栏 ========== */
	.page-header {
		background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-bg-dark) 100%);
		color: #fff;
		padding: 48px 0;
		text-align: center;
	}

	.page-header h1 {
		font-size: 36px;
		margin-bottom: 12px;
	}

	.page-header p {
		color: #94a3b8;
		font-size: 16px;
	}

	/* ========== 通用 ========== */
	.container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 24px;
	}

	/* ========== 询价区域 ========== */
	.inquiry-section {
		padding: 48px 0 80px;
		background: var(--color-bg-light);
	}

	.inquiry-layout {
		display: grid;
		grid-template-columns: 1fr 360px;
		gap: 32px;
		align-items: start;
	}

	/* ========== 表单 ========== */
	.inquiry-form-wrapper {
		background: #fff;
		border-radius: 16px;
		padding: 40px;
		border: 1px solid var(--color-border);
		box-shadow: 0 4px 16px rgba(0,0,0,0.06);
	}

	.inquiry-form-wrapper h2 {
		font-size: 22px;
		margin-bottom: 32px;
		color: var(--color-text);
		padding-bottom: 16px;
		border-bottom: 2px solid var(--color-bg-light);
	}

	.form-section {
		margin-bottom: 32px;
	}

	.form-section h3 {
		font-size: 16px;
		margin-bottom: 20px;
		color: var(--color-primary);
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.required {
		color: var(--color-accent);
	}

	.form-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
		margin-bottom: 16px;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.form-group.full {
		grid-column: 1 / -1;
	}

	.form-group label {
		font-size: 14px;
		font-weight: 500;
		color: var(--color-text);
	}

	.form-group input,
	.form-group select,
	.form-group textarea {
		padding: 12px 16px;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		font-size: 14px;
		font-family: inherit;
		outline: none;
		transition: border-color 0.2s;
	}

	.form-group input:focus,
	.form-group select:focus,
	.form-group textarea:focus {
		border-color: var(--color-primary);
	}

	.form-group input::placeholder,
	.form-group textarea::placeholder {
		color: #adb5bd;
	}

	.form-group textarea {
		resize: vertical;
		min-height: 100px;
	}

	.form-group.qty input {
		width: 120px;
	}

	/* ========== 产品列表 ========== */
	.product-list {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.product-item {
		background: var(--color-bg-light);
		padding: 24px;
		border-radius: 12px;
		border: 1px solid var(--color-border);
		position: relative;
	}

	.btn-remove-product {
		position: absolute;
		top: 12px;
		right: 12px;
		background: #fee2e2;
		color: var(--color-accent);
		border: none;
		padding: 6px 12px;
		border-radius: 6px;
		font-size: 13px;
		cursor: pointer;
		font-family: inherit;
		transition: all 0.2s;
	}

	.btn-remove-product:hover {
		background: var(--color-accent);
		color: #fff;
	}

	.btn-add-product {
		width: 100%;
		padding: 14px;
		background: transparent;
		border: 2px dashed var(--color-border);
		border-radius: 10px;
		color: var(--color-secondary);
		font-size: 14px;
		font-weight: 600;
		cursor: pointer;
		font-family: inherit;
		transition: all 0.2s;
	}

	.btn-add-product:hover {
		border-color: var(--color-primary);
		background: rgba(26,58,92,0.04);
	}

	/* ========== 提交按钮 ========== */
	.form-actions {
		margin-top: 40px;
		text-align: center;
	}

	.btn-submit {
		background: var(--color-accent);
		color: #fff;
		padding: 16px 64px;
		border: none;
		border-radius: 10px;
		font-size: 16px;
		font-weight: 700;
		cursor: pointer;
		font-family: inherit;
		transition: all 0.2s;
	}

	.btn-submit:hover {
		background: #c1121f;
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(230,57,70,0.35);
	}

	.form-note {
		margin-top: 16px;
		font-size: 13px;
		color: var(--color-text-light);
	}

	/* ========== 侧边栏 ========== */
	.inquiry-sidebar {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}

	.sidebar-card {
		background: #fff;
		border-radius: 16px;
		padding: 28px;
		border: 1px solid var(--color-border);
		box-shadow: 0 4px 16px rgba(0,0,0,0.06);
	}

	.sidebar-card h3 {
		font-size: 17px;
		margin-bottom: 20px;
		color: var(--color-text);
	}

	.benefits-list {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.benefits-list li {
		display: flex;
		gap: 14px;
		align-items: flex-start;
	}

	.benefit-icon {
		font-size: 24px;
		flex-shrink: 0;
	}

	.benefits-list strong {
		display: block;
		font-size: 14px;
		margin-bottom: 4px;
		color: var(--color-text);
	}

	.benefits-list p {
		font-size: 13px;
		color: var(--color-text-light);
	}

	.contact-card .contact-item {
		display: flex;
		gap: 12px;
		margin-bottom: 16px;
		align-items: flex-start;
	}

	.contact-card .contact-item:last-child {
		margin-bottom: 0;
	}

	.contact-card .contact-item span {
		font-size: 20px;
	}

	.contact-label {
		font-size: 12px;
		color: var(--color-text-light);
		margin-bottom: 2px;
	}

	.contact-value {
		font-size: 14px;
		color: var(--color-text);
		font-weight: 500;
	}

	/* ========== 成功弹窗 ========== */
	.success-modal {
		position: fixed;
		inset: 0;
		background: rgba(0,0,0,0.6);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 1000;
	}

	.success-content {
		background: #fff;
		border-radius: 20px;
		padding: 48px;
		text-align: center;
		max-width: 440px;
		width: 90%;
	}

	.success-icon {
		font-size: 64px;
		margin-bottom: 20px;
	}

	.success-content h2 {
		font-size: 24px;
		margin-bottom: 16px;
		color: var(--color-text);
	}

	.success-content p {
		font-size: 15px;
		color: var(--color-text-light);
		line-height: 1.7;
		margin-bottom: 8px;
	}

	.btn-close {
		margin-top: 24px;
		background: var(--color-primary);
		color: #fff;
		padding: 12px 40px;
		border: none;
		border-radius: 8px;
		font-size: 15px;
		font-weight: 600;
		cursor: pointer;
		font-family: inherit;
		transition: background 0.2s;
	}

	.btn-close:hover {
		background: var(--color-secondary);
	}

	/* ========== 响应式 ========== */
	@media (max-width: 1024px) {
		.inquiry-layout {
			grid-template-columns: 1fr;
		}

		.inquiry-sidebar {
			flex-direction: row;
		}

		.inquiry-sidebar .sidebar-card {
			flex: 1;
		}
	}

	@media (max-width: 768px) {
		.inquiry-form-wrapper {
			padding: 24px;
		}

		.form-row {
			grid-template-columns: 1fr;
		}

		.inquiry-sidebar {
			flex-direction: column;
		}

		.success-content {
			padding: 32px 24px;
		}
	}
</style>
