---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return [
    { params: { id: '1' } },
    { params: { id: '2' } },
    { params: { id: '3' } },
    { params: { id: '4' } },
    { params: { id: '5' } },
    { params: { id: '6' } },
  ];
}

const { id } = Astro.params;

const products: Record<string, any> = {
  1: { series: '300', name: 'Front Bumper', price: 649, category: 'Bumpers', badge: 'Best Seller', description: 'Our most popular front bumper for the Tank 300. Precision-engineered for a perfect fit, this bumper transforms the front end with an aggressive, off-road ready look. Made from high-quality FRP (fiberglass reinforced plastic) for durability and easy painting.', oem: 'TG-FB300-001', material: 'FRP (Fiberglass Reinforced Plastic)', finish: 'Gel coat (ready to paint)', fitment: 'GWM Tank 300 (2021–Present)', weight: '8.5 kg' },
  2: { series: '400', name: 'Side Skirt Set', price: 499, category: 'Side Skirts', badge: 'Popular', description: 'Complete side skirt set for the Tank 400. Adds a sleek, lowered appearance while providing basic underbody airflow management. Includes all mounting hardware and fitting instructions.', oem: 'TG-SS400-001', material: 'ABS Plastic', finish: 'Primer coat (ready to paint)', fitment: 'GWM Tank 400 (2022–Present)', weight: '6.2 kg' },
  3: { series: '500', name: 'Rear Bumper', price: 729, category: 'Bumpers', badge: 'New', description: 'Aggressive rear bumper design for the Tank 500. Features integrated tow points and a diffuser-style lower section. Perfect for completing the rugged look.', oem: 'TG-RB500-001', material: 'FRP', finish: 'Gel coat (ready to paint)', fitment: 'GWM Tank 500 (2022–Present)', weight: '9.8 kg' },
  4: { series: '300', name: 'Rear Spoiler', price: 399, category: 'Spoilers', badge: '', description: 'A subtle rear spoiler that adds a sporty touch without being too aggressive. Improves rear-end aesthetics while maintaining a clean, factory-plus appearance.', oem: 'TG-RS300-001', material: 'ABS Plastic', finish: 'Gloss black (premium finish)', fitment: 'GWM Tank 300 (2021–Present)', weight: '3.1 kg' },
  5: { series: '400', name: 'Wide Body Kit', price: 2499, category: 'Body Kits', badge: 'Premium', description: 'Complete wide body kit for the Tank 400. Includes front bumper, rear bumper, side skirts, and fender flares. Transforms your Tank 400 into a true wide-body beast.', oem: 'TG-WBK400-001', material: 'FRP / ABS mix', finish: 'Gel coat (ready to paint)', fitment: 'GWM Tank 400 (2022–Present)', weight: '42 kg (full kit)' },
  6: { series: '500', name: 'Carbon Hood', price: 1199, category: 'Hoods', badge: 'Carbon', description: 'Lightweight carbon fiber hood for the Tank 500. Reduces hood weight by 60% compared to stock while adding aggressive vent styling for improved engine bay cooling.', oem: 'TG-CH500-001', material: '2x2 Carbon Fiber weave', finish: 'Gloss clear coat', fitment: 'GWM Tank 500 (2022–Present)', weight: '4.2 kg' },
};

const product = products[id as string] || products[1];
---

<Layout>
  <!-- Breadcrumb -->
  <div class="breadcrumb">
    <div class="container">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/shop">Shop</a>
      <span>/</span>
      <a href={`/shop?series=${product.series}`}>Tank {product.series}</a>
      <span>/</span>
      <span>{product.name}</span>
    </div>
  </div>

  <section class="product-detail">
    <div class="container">
      <div class="detail-grid">
        <!-- Image -->
        <div class="detail-gallery">
          <div class="gallery-main card">
            <span class="gallery-placeholder">Product Image</span>
          </div>
          <div class="gallery-thumbs">
            <div class="thumb card"><span>Image 1</span></div>
            <div class="thumb card"><span>Image 2</span></div>
            <div class="thumb card"><span>Image 3</span></div>
          </div>
        </div>

        <!-- Info -->
        <div class="detail-info">
          <span class="product-series">Tank {product.series}</span>
          <h1>{product.name}</h1>
          <p class="product-category">{product.category}</p>

          <div class="price-box card">
            <span class="price">${product.price.toLocaleString()}</span>
            <span class="price-note">AUD · Free shipping over $500</span>
          </div>

          <p class="product-desc">{product.description}</p>

          <div class="specs-box card">
            <h3>Specifications</h3>
            <div class="spec-row"><span>OEM Part #</span><span>{product.oem}</span></div>
            <div class="spec-row"><span>Material</span><span>{product.material}</span></div>
            <div class="spec-row"><span>Finish</span><span>{product.finish}</span></div>
            <div class="spec-row"><span>Fitment</span><span>{product.fitment}</span></div>
            <div class="spec-row"><span>Weight</span><span>{product.weight}</span></div>
          </div>

          <!-- Qty -->
          <div class="qty-section">
            <label>Quantity</label>
            <div class="qty-control">
              <button class="qty-btn" id="qtyMinus">−</button>
              <input type="number" id="qtyInput" value="1" min="1" />
              <button class="qty-btn" id="qtyPlus">+</button>
            </div>
          </div>

          <!-- Actions -->
          <div class="action-buttons">
            <button class="btn-add-cart" id="addCartBtn">🛒 Add to Cart</button>
            <button class="btn-buy-now" id="buyNowBtn">Buy Now</button>
          </div>

          <div class="cart-toast" id="cartToast">✅ Added to cart!</div>

          <div class="trust-row">
            <span>🚚 Australia-Wide Shipping</span>
            <span>✅ Quality Guaranteed</span>
            <span>💬 Expert Support</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const CART_KEY = 'tankgarage_cart';

  function getCart() {
    try { return JSON.parse(localStorage.getItem(CART_KEY) || '[]'); } catch { return []; }
  }

  function saveCart(cart: any[]) {
    localStorage.setItem(CART_KEY, JSON.stringify(cart));
    const total = cart.reduce((s: number, i: any) => s + i.quantity, 0);
    window.dispatchEvent(new CustomEvent('cart-updated', { detail: { count: total } }));
  }

  document.getElementById('addCartBtn')?.addEventListener('click', () => {
    const qtyInput = document.getElementById('qtyInput') as HTMLInputElement;
    const qty = parseInt(qtyInput?.value || '1');
    const cart = getCart();
    const prodId = window.location.pathname.split('/').pop();
    const existing = cart.find((i: any) => i.id === prodId);
    const priceEl = document.querySelector('.price');
    const nameEl = document.querySelector('h1');
    if (existing) {
      existing.quantity = Math.min(existing.quantity + qty, 99);
    } else {
      cart.push({
        id: prodId,
        name: nameEl?.textContent || '',
        price: parseInt((priceEl?.textContent || '$0').replace(/[$,]/g, '')) || 0,
        quantity: qty
      });
    }
    saveCart(cart);
    const toast = document.getElementById('cartToast');
    if (toast) { toast.classList.add('show'); setTimeout(() => toast.classList.remove('show'), 2000); }
  });

  document.getElementById('buyNowBtn')?.addEventListener('click', () => {
    window.location.href = '/cart';
  });

  document.getElementById('qtyMinus')?.addEventListener('click', () => {
    const input = document.getElementById('qtyInput') as HTMLInputElement;
    input.value = String(Math.max(1, parseInt(input.value || '1') - 1));
  });
  document.getElementById('qtyPlus')?.addEventListener('click', () => {
    const input = document.getElementById('qtyInput') as HTMLInputElement;
    input.value = String(Math.min(99, parseInt(input.value || '1') + 1));
  });
</script>

<style>
  .breadcrumb {
    padding: 16px 0;
    font-size: 13px;
    color: var(--color-text-muted);
  }
  .breadcrumb .container {
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .breadcrumb a { color: var(--color-text-muted); }
  .breadcrumb a:hover { color: var(--color-primary); }
  .breadcrumb span { opacity: 0.5; }

  .product-detail { padding: 40px 0 80px; }

  .detail-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }

  /* Gallery */
  .gallery-main {
    aspect-ratio: 4/3;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }
  .gallery-placeholder {
    font-size: 14px;
    color: rgba(0,0,0,0.2);
  }
  .gallery-thumbs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  .thumb {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: rgba(0,0,0,0.2);
  }

  /* Info */
  .product-series {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }
  h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 32px;
    font-weight: 800;
    margin: 8px 0;
    color: var(--color-text);
  }
  .product-category {
    font-size: 14px;
    color: var(--color-text-muted);
    margin-bottom: 24px;
  }

  .price-box {
    padding: 20px;
    margin-bottom: 24px;
    border-radius: var(--radius-sm);
  }
  .price {
    display: block;
    font-size: 36px;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 4px;
  }
  .price-note {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .product-desc {
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 24px;
  }

  .specs-box {
    padding: 20px;
    margin-bottom: 24px;
    border-radius: var(--radius-sm);
  }
  .specs-box h3 {
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-text);
  }
  .spec-row {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    padding: 8px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .spec-row:last-child { border-bottom: none; }
  .spec-row span:first-child { color: var(--color-text-muted); }
  .spec-row span:last-child { font-weight: 600; color: var(--color-text); }

  .qty-section { margin-bottom: 20px; }
  .qty-section label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 10px;
    color: var(--color-text);
  }
  .qty-control {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .qty-btn {
    width: 44px;
    height: 44px;
    background: transparent;
    border: none;
    color: var(--color-text);
    font-size: 18px;
    cursor: pointer;
    transition: background 0.2s;
    font-family: inherit;
  }
  .qty-btn:hover { background: var(--color-bg-secondary); }
  #qtyInput {
    width: 60px;
    height: 44px;
    border: none;
    border-left: 1px solid var(--color-border);
    border-right: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    text-align: center;
    font-size: 16px;
    font-weight: 600;
    font-family: inherit;
    outline: none;
    -moz-appearance: textfield;
  }
  #qtyInput::-webkit-outer-spin-button, #qtyInput::-webkit-inner-spin-button { -webkit-appearance: none; }

  .action-buttons {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
  }
  .btn-add-cart {
    flex: 1;
    padding: 14px;
    background: var(--color-primary);
    color: #fff;
    border: none;
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s;
  }
  .btn-add-cart:hover { background: var(--color-primary-dark); transform: translateY(-2px); }
  .btn-buy-now {
    flex: 1;
    padding: 14px;
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s;
  }
  .btn-buy-now:hover { border-color: var(--color-primary); color: var(--color-primary); }

  .cart-toast {
    text-align: center;
    padding: 12px;
    background: rgba(255,69,0,0.08);
    border: 1px solid rgba(255,69,0,0.25);
    border-radius: var(--radius-sm);
    font-size: 14px;
    color: var(--color-primary);
    margin-bottom: 20px;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .cart-toast.show { opacity: 1; }

  .trust-row {
    display: flex;
    gap: 20px;
    font-size: 12px;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .detail-grid { grid-template-columns: 1fr; }
  }
</style>
